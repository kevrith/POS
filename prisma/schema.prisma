generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                              String   @id @default(uuid())
  name                            String
  taxType                         String   @default("VAT")   // 'VAT' | 'TOT' | 'NONE'
  serviceChargeRate               Float    @default(10)
  serviceChargeDefault            Boolean  @default(false)   // auto-apply service charge on every sale
  negativePolicyDefault           String   @default("BLOCK")
  posMode                         String   @default("RETAIL")
  expiredItemPolicy               String   @default("BLOCK")
  expenseApprovalThresholdCents   Int?     @default(500000)
  expiryAlertDays                 Int      @default(30)
  etimsCredentialsEncrypted       String?
  mpesaCredentialsEncrypted       String?
  atCredentialsEncrypted          String?
  etimsMode                       String   @default("SANDBOX") // SANDBOX | PRODUCTION
  etimsProductionOnboarded        Boolean  @default(false)
  kraItaxIntegrationEnabled       Boolean  @default(false)
  kraItaxCredentials              String?  // Encrypted iTax credentials
  subscriptionTier                String   @default("TRIAL")
  subscriptionStatus              String   @default("TRIAL")
  trialEndsAt                     DateTime?
  planName                        String   @default("STARTER")  // STARTER | PRO | ENTERPRISE
  paystackCustomerId              String?
  paystackSubscriptionId          String?
  paystackPublicKey               String?  // POS card payment public key
  referralCode                    String?  @unique
  cancelledAt                     DateTime?
  cancelReason                    String?  // PRICE | COMPETITOR | MISSING_FEATURE | POOR_SUPPORT | OTHER
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  stores                          Store[]
  users                           User[]
  apiKeys                         ApiKey[]
  auditLogs                       AuditLog[]
  reportSchedules                 ReportSchedule[]
  webhooks                        Webhook[]
  referrals                       Referral[]       @relation("ReferrerBusiness")
  prescriptions                   Prescription[]
  appointments                    Appointment[]
  deliveries                      DeliveryOrder[]
  exchangeRates                   String?          // JSON: { USD: 130.5, EUR: 141.2 }
  displayCurrencies               String?          // JSON: ["USD","EUR"]
  bankName                        String?
  bankAccountNumber               String?
  bankAccountName                 String?
  bankBranch                      String?
  idleMessage                     String?  @default("Welcome!")
  idleLogoUrl                     String?
  tablePrefix                     String?  @default("T")
  receiptHeader                   String?
  receiptFooter                   String?
  enableCashDrawer                Boolean  @default(false)
  enableBarcodeScanner            Boolean  @default(true)
  enablePoleDisplay               Boolean  @default(false)
  parentBusinessId                String?
  parentBusiness                  Business?  @relation("FranchiseHierarchy", fields: [parentBusinessId], references: [id])
  franchisees                     Business[] @relation("FranchiseHierarchy")
  franchiseFee                    Float?     @default(0)
  royaltyRate                     Float?     @default(0)

  @@index([subscriptionStatus])
  @@index([referralCode])
}

model FranchiseReport {
  id                   String   @id @default(cuid())
  franchiseeBusinessId String
  franchiseeBusinessName String
  parentBusinessId     String
  month                Int
  year                 Int
  gmvCents             Int      @default(0)
  feeCents             Int      @default(0)
  royaltyCents         Int      @default(0)
  salesCount           Int      @default(0)
  createdAt            DateTime @default(now())
  @@unique([franchiseeBusinessId, month, year])
}

model User {
  id                String   @id @default(uuid())
  businessId        String
  email             String?  @unique
  name              String
  role              String
  passwordHash      String?
  pin               String?
  pinHash           String?
  totpSecret        String?
  googleId          String?  @unique
  avatarUrl         String?
  deviceToken       String?
  phone             String?
  passwordChangedAt DateTime?
  passwordExpiresAt DateTime?
  mustChangePassword Boolean  @default(false)
  loginAttempts     Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business          Business @relation(fields: [businessId], references: [id])
  employee          Employee?
  sales             Sale[]
  orders            Order[]
  assignedKOTs      KOT[]     @relation("ChefKOTs")
  assignedStores    UserStore[]
  sessions          UserSession[]

  @@index([businessId, role])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id                String   @id @default(uuid())
  businessId        String
  name              String
  storeCode         String   @unique
  receiptSequence   Int      @default(0)
  proformaSequence  Int      @default(0)
  zReportSequence   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business          Business @relation(fields: [businessId], references: [id])
  items             Item[]
  sales             Sale[]
  orders            Order[]
  tables            Table[]
  printers          Printer[]
  assignedUsers     UserStore[]
  prescriptions     Prescription[]
  appointments      Appointment[]
  deliveries        DeliveryOrder[]

  @@index([businessId])
}

model Item {
  id                      String    @id @default(uuid())
  offlineId               String?   @unique
  businessId              String
  storeId                 String
  name                    String
  type                    String    @default("PRODUCT")
  retailPriceCents        Int
  wholesalePriceCents     Int?
  vipPriceCents           Int?
  costPriceCents          Int?
  trackStock              Boolean   @default(true)
  trackSerials            Boolean   @default(false)
  trackBatches            Boolean   @default(false)
  trackExpiry             Boolean   @default(false)
  defaultExpiryDays       Int?
  negativeStockPolicy     String?
  weightUnit              String?
  reorderLevel            Int?      @default(0)
  vatApplicable           Boolean   @default(true)
  totApplicable           Boolean   @default(false)
  barcode                 String?
  category                String?
  ageRestricted           Boolean   @default(false)
  minAgeYears             Int       @default(18)
  prepTimeMinutes         Int       @default(5)
  unitWeightGrams         Int?
  isActive                Boolean   @default(true)
  imageUrl                String?
  allergens               String    @default("[]")
  reorderQty              Int       @default(1)
  tareWeightGrams         Int?
  binLocation             String?
  isWeighed               Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  store                   Store     @relation(fields: [storeId], references: [id])
  batches                 Batch[]
  movements               InventoryMovement[]
  bundleComponents        BundleComponent[] @relation("BundleItem")
  componentOf             BundleComponent[] @relation("ComponentItem")
  recipeIngredients       RecipeIngredient[] @relation("RecipeItem")
  ingredientOf            RecipeIngredient[] @relation("IngredientItem")
  saleItems               SaleItem[]
  orderItems              OrderItem[]
  serialRecords           SerialRecord[]
  variants                ItemVariant[]
  supplierReturnItems     SupplierReturnItem[]
  damagedGoodsRecords     DamagedGoodsRecord[]

  @@index([businessId, storeId])
  @@index([type])
  @@index([barcode])
  @@index([offlineId])
}

model ItemVariant {
  id                  String   @id @default(uuid())
  itemId              String
  name                String
  sku                 String?  @unique
  barcode             String?  @unique
  retailPriceCents    Int
  wholesalePriceCents Int?
  vipPriceCents       Int?
  costPriceCents      Int?
  attributes          String
  trackStock          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  item                Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([barcode])
  @@index([sku])
}

model Batch {
  id                String    @id @default(uuid())
  offlineId         String    @unique
  itemId            String
  storeId           String
  lotNumber         String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  supplierId        String?
  quantityReceived  Int
  quantityRemaining Int
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  item              Item      @relation(fields: [itemId], references: [id])
  movements         InventoryMovement[]

  @@index([itemId, expiryDate])
  @@index([status])
}

model Sale {
  id                    String    @id @default(uuid())
  offlineId             String    @unique
  businessId            String
  storeId               String?
  receiptNumber         String?   @unique
  amendmentNumber       String?
  orderId               String?   @unique
  cashierId             String?
  customerId            String?
  customerName          String?
  customerPhone         String?
  notes                 String?
  proformaValidUntil    DateTime?
  type                  String    @default("NORMAL")
  status                String    @default("DRAFT")
  priceLevel            String    @default("RETAIL")
  subtotalCents         Int       @default(0)
  serviceChargeCents    Int       @default(0)
  discountCents         Int       @default(0)
  tipCents              Int       @default(0)
  promotionId           String?
  vatCents              Int       @default(0)
  totCents              Int       @default(0)
  totalCents            Int       @default(0)
  etimsSubmitted        Boolean   @default(false)
  etimsControlNumber    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  store               Store?    @relation(fields: [storeId], references: [id])
  cashier             User?     @relation(fields: [cashierId], references: [id])
  customer            Customer? @relation(fields: [customerId], references: [id])
  order               Order?    @relation(fields: [orderId], references: [id])
  layaway             Layaway?
  items               SaleItem[]
  payments            Payment[]
  movements           InventoryMovement[]
  voidRecords         VoidRecord[]
  serialRecords       SerialRecord[]
  returns             Return[]
  deliveries          DeliveryOrder[]

  @@index([businessId, storeId, status])
  @@index([receiptNumber])
  @@index([offlineId])
}

model Order {
  id          String    @id @default(uuid())
  offlineId   String    @unique
  businessId  String
  storeId     String
  tableId     String?
  roomNumber  String?
  waiterId    String
  status      String    @default("OPEN")
  mode        String    @default("HOSPITALITY")
  priority    Int       @default(0)
  isVIP       Boolean   @default(false)
  coverCount  Int       @default(1)
  tableNotes  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id])
  waiter      User      @relation(fields: [waiterId], references: [id])
  table       Table?    @relation(fields: [tableId], references: [id])
  items       OrderItem[]
  kots        KOT[]
  sale        Sale?

  @@index([businessId, storeId, status])
  @@index([offlineId])
}

model Employee {
  id               String    @id @default(uuid())
  userId           String    @unique
  businessId       String
  idNumber         String?
  emergencyContact String?
  employmentType   String    @default("PERMANENT")
  commissionRate               Float     @default(0)
  commissionBasis              String    @default("SALES_VALUE")  // SALES_VALUE | TRANSACTION_COUNT | GROSS_MARGIN
  salesTargetCents             Int?
  commissionMilestonePercent   Float?   @default(0)
  // Payroll fields
  salaryBaseCents              Int      @default(0)
  housingAllowanceCents        Int      @default(0)
  transportAllowanceCents      Int      @default(0)
  otherAllowancesCents         Int      @default(0)
  // Deductions
  saccoDeductionCents          Int      @default(0)   // SACCO/welfare deduction
  loanDeductionCents           Int      @default(0)   // salary advance/loan repayment
  otherDeductionsCents         Int      @default(0)   // any other recurring deduction
  bankAccountNumber            String?
  bankName                     String?
  startDate                    DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id])
  attendance       AttendanceRecord[]
  leaves           Leave[]
  leaveBalances    LeaveBalance[]
  expenseClaims    ExpenseClaim[]
  disciplinaryRecords     DisciplinaryRecord[]
  housekeepingAssignments HousekeepingAssignment[]
  contractEndDate  DateTime?
  contractType     String?   @default("PERMANENT")  // PERMANENT | CONTRACT | CASUAL

  @@index([businessId])
}

model ExpenseClaim {
  id              String   @id @default(uuid())
  businessId      String
  employeeId      String
  amountCents     Int
  description     String
  category        String   @default("OTHER")
  receiptUrl      String?
  status          String   @default("PENDING")
  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee        Employee @relation(fields: [employeeId], references: [id])

  @@index([businessId])
  @@index([employeeId])
}

model AuditLog {
  id            String   @id @default(uuid())
  businessId    String
  previousHash  String
  hash          String
  actor         String
  actorType     String
  action        String
  entity        String
  entityId      String
  before        String?
  after         String?
  source        String
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([entity, entityId])
}

model ApiKey {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  keyHash         String   @unique
  scopes          String
  ipWhitelist     String
  isActive        Boolean  @default(true)
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String
  itemId          String?
  name            String
  quantity        Int
  unitPriceCents  Int
  totalCents      Int
  createdAt       DateTime @default(now())

  sale            Sale     @relation(fields: [saleId], references: [id])
  item            Item?    @relation(fields: [itemId], references: [id])

  @@index([saleId])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  itemId              String
  name                String
  quantity            Int
  unitPriceCents      Int
  totalCents          Int
  specialInstructions String?
  modifiers           String?
  course              String?   // STARTER | MAIN | DESSERT
  firedAt             DateTime?
  seatNumber          Int?      @default(0)  // 0 = shared/whole-table, 1..N = individual guest seat
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id])
  item                Item     @relation(fields: [itemId], references: [id])

  @@index([orderId])
}

model Payment {
  id              String   @id @default(uuid())
  offlineId       String   @unique
  saleId          String
  method          String
  amountCents     Int
  reference       String?
  createdAt       DateTime @default(now())

  sale            Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model VoidRecord {
  id                String   @id @default(uuid())
  saleId            String
  type              String
  authorizedBy      String
  reason            String
  voidedItemIds     String
  refundAmountCents Int
  etimsVoidRef      String?
  createdAt         DateTime @default(now())

  sale              Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model InventoryMovement {
  id              String    @id @default(uuid())
  offlineId       String    @unique
  businessId      String
  itemId          String
  storeId         String
  type            String
  quantity        Int
  batchId         String?
  saleId          String?
  recipeItemId    String?
  bundleItemId    String?
  grnId           String?
  variantId       String?
  source          String
  createdAt       DateTime  @default(now())

  item            Item      @relation(fields: [itemId], references: [id])
  batch           Batch?    @relation(fields: [batchId], references: [id])
  sale            Sale?     @relation(fields: [saleId], references: [id])

  @@index([businessId, itemId, createdAt])
  @@index([type])
  @@index([offlineId])
}

model Table {
  id           String             @id @default(uuid())
  storeId      String
  number       String
  capacity     Int
  floor        String?
  status       String             @default("AVAILABLE")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  store        Store              @relation(fields: [storeId], references: [id])
  orders       Order[]
  reservations TableReservation[]

  @@index([storeId, status])
}

model Printer {
  id                String   @id @default(uuid())
  storeId           String
  name              String
  connectionType    String
  connectionDetails String
  isDefault         Boolean  @default(false)
  handles           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store             Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model BundleComponent {
  id                String   @id @default(uuid())
  bundleItemId      String
  componentItemId   String
  quantity          Int
  createdAt         DateTime @default(now())

  bundleItem        Item     @relation("BundleItem", fields: [bundleItemId], references: [id])
  componentItem     Item     @relation("ComponentItem", fields: [componentItemId], references: [id])

  @@index([bundleItemId])
}

model RecipeIngredient {
  id                String   @id @default(uuid())
  recipeItemId      String
  ingredientItemId  String
  quantityGrams     Float
  createdAt         DateTime @default(now())

  recipeItem        Item     @relation("RecipeItem", fields: [recipeItemId], references: [id])
  ingredientItem    Item     @relation("IngredientItem", fields: [ingredientItemId], references: [id])

  @@index([recipeItemId])
}

model Supplier {
  id                      String   @id @default(uuid())
  businessId              String
  name                    String
  contact                 String?
  address                 String?
  paymentTerms            String?
  creditLimitCents        Int?
  outstandingBalanceCents Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  purchaseOrders          PurchaseOrder[]
  creditNotes             SupplierCreditNote[]
  returns                 SupplierReturn[]
  invoices                SupplierInvoice[]
  priceAgreements         SupplierPriceAgreement[]
  rfqResponses            RFQResponse[]

  @@index([businessId])
}

model PurchaseOrder {
  id                String    @id @default(uuid())
  poNumber          String    @unique
  businessId        String
  supplierId        String
  status            String    @default("DRAFT")
  expectedDelivery  DateTime?
  notes             String?
  invoiceNumber     String?
  invoicedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  items             POItem[]
  grns              GRN[]

  @@index([businessId, supplierId, status])
}

model POItem {
  id                String   @id @default(uuid())
  poId              String
  itemId            String
  quantityOrdered   Int
  agreedPriceCents  Int
  createdAt         DateTime @default(now())

  po                PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([poId])
}

model GRN {
  id                    String   @id @default(uuid())
  poId                  String
  receivedAt            DateTime @default(now())
  freightCents          Int      @default(0)
  dutyPaidCents         Int      @default(0)
  landedCostAllocated   Boolean  @default(false)
  createdAt             DateTime @default(now())

  po          PurchaseOrder @relation(fields: [poId], references: [id])
  items       GRNItem[]

  @@index([poId])
}

model GRNItem {
  id                String    @id @default(uuid())
  grnId             String
  poItemId          String
  quantityReceived  Int
  batchLotNumber    String?
  expiryDate        DateTime?
  landedCostCents   Int       @default(0)
  createdAt         DateTime  @default(now())

  grn               GRN       @relation(fields: [grnId], references: [id])

  @@index([grnId])
}

model Expense {
  id                    String    @id @default(uuid())
  offlineId             String    @unique
  businessId            String
  storeId               String
  amountCents           Int
  category              String
  description           String
  paidBy                String
  receiptPhotoUrl       String?
  isRecurring           Boolean   @default(false)
  recurringDay          Int?
  approvalStatus        String    @default("APPROVED")
  approvedBy            String?
  submittedBy           String
  cashDrawerSessionId   String?
  vatReclaimable        Boolean   @default(false)
  vatAmountCents        Int       @default(0)
  currentApprovalLevel  Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  approvalSteps         ExpenseApprovalStep[]

  @@index([businessId, category, createdAt])
  @@index([approvalStatus])
}

model AttendanceRecord {
  id          String    @id @default(uuid())
  offlineId   String    @unique
  employeeId  String
  storeId     String
  clockIn     DateTime
  clockOut    DateTime?
  isLate      Boolean   @default(false)
  shiftDate   DateTime
  createdAt   DateTime  @default(now())

  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, shiftDate])
}

model Leave {
  id          String   @id @default(uuid())
  employeeId  String
  type        String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING")
  approvedBy  String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model Customer {
  id                        String   @id @default(uuid())
  businessId                String
  name                      String
  phone                     String?
  email                     String?
  creditLimitCents          Int      @default(0)
  creditLimitPendingCents   Int      @default(0)
  creditApprovalStatus      String   @default("NONE")  // NONE | PENDING | APPROVED | REJECTED
  balanceCents              Int      @default(0)
  loyaltyPoints             Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  sales             Sale[]
  layaways          Layaway[]
  appointments      Appointment[]
  deliveries        DeliveryOrder[]

  @@index([businessId])
  @@index([phone])
}

model Layaway {
  id                String   @id @default(uuid())
  offlineId         String   @unique
  businessId        String
  storeId           String
  customerId        String
  saleId            String?  @unique
  status            String   @default("ACTIVE")
  totalCents        Int
  paidCents         Int      @default(0)
  remainingCents    Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          Customer @relation(fields: [customerId], references: [id])
  sale              Sale?    @relation(fields: [saleId], references: [id])
  payments          LayawayPayment[]

  @@index([businessId, customerId, status])
}

model LayawayPayment {
  id          String   @id @default(uuid())
  layawayId   String
  amountCents Int
  method      String
  reference   String?
  createdAt   DateTime @default(now())

  layaway     Layaway  @relation(fields: [layawayId], references: [id])

  @@index([layawayId])
}

model SerialRecord {
  id            String   @id @default(uuid())
  itemId        String
  saleId        String?
  serialNumber  String   @unique
  status        String   @default("AVAILABLE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item          Item     @relation(fields: [itemId], references: [id])
  sale          Sale?    @relation(fields: [saleId], references: [id])

  @@index([itemId, status])
  @@index([serialNumber])
}

model CashDrawerSession {
  id                      String    @id @default(uuid())
  businessId              String
  storeId                 String
  cashierId               String
  status                  String    @default("OPEN")
  openingBalanceCents     Int
  closingBalanceCents     Int?
  expectedBalanceCents    Int?
  varianceCents           Int?
  notes                   String?
  tillNumber              Int       @default(1)
  tillLabel               String?
  openedAt                DateTime  @default(now())
  closedAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([businessId, storeId, cashierId])
  @@index([status])
  @@index([businessId, storeId, tillNumber])
}

model UserStore {
  id          String   @id @default(uuid())
  userId      String
  storeId     String
  businessId  String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([businessId])
}

model StoreTransfer {
  id                String    @id @default(uuid())
  offlineId         String    @unique
  businessId        String
  fromStoreId       String
  toStoreId         String
  status            String    @default("PENDING")
  initiatedBy       String
  receivedBy        String?
  approvedBy        String?
