{
  "expo": {
    "name": "KASTRA POS",
    "slug": "kastra-pos-cashier",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kastra-pos",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F0F2F5"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ke.kastra.pos",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan product barcodes at point of sale.",
        "NSPhotoLibraryUsageDescription": "Used to attach receipt photos to expense records.",
        "NSLocalNetworkUsageDescription": "Used to send receipts to a Wi-Fi receipt printer on your network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "package": "co.ke.kastra.pos",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow KASTRA POS to use Face ID to sign you in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KASTRA POS to access your camera for barcode scanning."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#030712"
        }
      ],
      "./plugins/with-cleartext-traffic",
      "./plugins/with-printer-permissions",
      "./plugins/with-gradle-properties"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3cd7f6fd-6fa7-4e28-a1cd-97fc5cfea9f1"
      }
    },
    "owner": "kevrith",
    "updates": {
      "url": "https://u.expo.dev/3cd7f6fd-6fa7-4e28-a1cd-97fc5cfea9f1"
    }
  }
}
