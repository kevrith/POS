  createdBy String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items     RFQItem[]
  responses RFQResponse[]

  @@index([businessId, status])
}

model RFQItem {
  id             String   @id @default(uuid())
  rfqId          String
  itemId         String
  quantityNeeded Int
  unitPriceCents Int      @default(0)
  createdAt      DateTime @default(now())

  rfq            RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model RFQResponse {
  id               String    @id @default(uuid())
  rfqId            String
  supplierId       String
  quotedPriceCents Int
  deliveryDays     Int?
  validUntil       DateTime?
  notes            String?
  status           String    @default("PENDING")  // PENDING | AWARDED | REJECTED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  rfq              RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier         Supplier @relation(fields: [supplierId], references: [id])

  @@index([rfqId])
  @@index([supplierId])
}

// Multi-level Expense Approval
model ExpenseApprovalStep {
  id         String   @id @default(uuid())
  expenseId  String
  level      Int
  approverId String
  status     String   @default("PENDING")  // PENDING | APPROVED | REJECTED
  comment    String?
  actionAt   DateTime?
  createdAt  DateTime @default(now())

  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, level])
}

// Cheque Payments
model ChequePayment {
  id              String    @id @default(uuid())
  businessId      String
  storeId         String
  saleId          String?
  supplierId      String?
  type            String    @default("RECEIVED")  // RECEIVED | ISSUED
  chequeNumber    String
  bankName        String
  drawerName      String
  amountCents     Int
  issueDate       DateTime
  clearanceDate   DateTime?
  status          String    @default("PENDING")  // PENDING | CLEARED | BOUNCED | CANCELLED
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId, status])
  @@index([chequeNumber])
}

// General Ledger
model JournalEntry {
  id          String        @id @default(uuid())
  businessId  String
  storeId     String?
  entryNumber String        @unique
  date        DateTime
  description String
  reference   String?
  sourceType  String?       // SALE | EXPENSE | PAYROLL | MANUAL | GRN
  status      String        @default("DRAFT")  // DRAFT | POSTED | REVERSED
  postedBy    String?
  postedAt    DateTime?
  reversalOf  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines       JournalLine[]

  @@index([businessId, date])
  @@index([status])
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  accountCode String
  accountName String
  debitCents  Int          @default(0)
  creditCents Int          @default(0)
  description String?
  createdAt   DateTime     @default(now())

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([accountCode])
}

// Payment Links
model PaymentLink {
  id          String    @id @default(uuid())
  businessId  String
  storeId     String?
  code        String    @unique
  description String
  amountCents Int       @default(0)
  currency    String    @default("KES")
  expiresAt   DateTime?
  maxUses     Int?
  usesCount   Int       @default(0)
  status      String    @default("ACTIVE")  // ACTIVE | EXPIRED | DISABLED
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, status])
  @@index([code])
}

// ─── Petty Cash ────────────────────────────────────────────────────────────────

model PettyCashFloat {
  id           String   @id @default(uuid())
  businessId   String
  storeId      String?
  balanceCents Int      @default(0)
  lastTopUpAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions PettyCashTransaction[]

  @@unique([businessId, storeId])
  @@index([businessId])
}

model PettyCashTransaction {
  id          String   @id @default(uuid())
  floatId     String
  type        String   // TOP_UP | DISBURSEMENT
  amountCents Int
  description String
  reference   String?
  userId      String
  createdAt   DateTime @default(now())

  float       PettyCashFloat @relation(fields: [floatId], references: [id])

  @@index([floatId])
}

// ─── Delivery Enhancement Models ──────────────────────────────────────────────

model DeliveryZone {
  id               String    @id @default(uuid())
  businessId       String
  name             String
  coordinates      String    // JSON array of lat/lng points defining the zone
  basePriceCents   Int       @default(0)
  pricePerKm       Int       @default(0)
  maxDistanceKm    Float     @default(10)
  estimatedMinutes Int       @default(30)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([businessId])
}

model DriverLocation {
  id              String    @id @default(uuid())
  driverId        String
  deliveryOrderId String?
  lat             Float
  lng             Float
  heading         Float?
  speed           Float?
  accuracy        Float?
  timestamp       DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([driverId, timestamp])
  @@index([deliveryOrderId])
}

model DeliverySLA {
  id                 String    @id @default(uuid())
  businessId         String
  deliveryOrderId    String
  promisedAt         DateTime
  actualDeliveredAt  DateTime?
  isOnTime           Boolean?
  delayMinutes       Int       @default(0)
  createdAt          DateTime  @default(now())

  @@index([businessId])
  @@index([deliveryOrderId])
}

model CourierIntegration {
  id          String    @id @default(uuid())
  businessId  String
  provider    String    // GLOVO | SENDY | UBER | BOLT
  apiKey      String?
  webhookUrl  String?
  isActive    Boolean   @default(true)
  config      String?   // JSON config for provider-specific settings
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, provider])
}

// ─── Security & Settings Models ───────────────────────────────────────────────

model CustomRole {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  permissions String    // JSON array of permission strings
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([businessId])
}

model Permission {
  id          String    @id @default(uuid())
  name        String
  category    String
  description String?
  endpoint    String?
  method      String?
  isActive    Boolean   @default(true)

  rolePermissions RolePermission[]

  @@index([category])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  role         CustomRole @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@index([roleId])
}

model TaxConfiguration {
  id              String    @id @default(uuid())
  businessId      String
  itemId          String?
  category        String?
  vatRate         Float     @default(16.0)
  totRate         Float     @default(3.0)
  isZeroRated     Boolean   @default(false)
  exemptionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId])
  @@index([itemId])
}

model PasswordPolicy {
  id                  String    @id @default(uuid())
  businessId          String
  minLength           Int       @default(8)
  requireUppercase    Boolean   @default(true)
  requireLowercase    Boolean   @default(true)
  requireNumbers      Boolean   @default(true)
  requireSpecialChars Boolean   @default(false)
  rotationDays        Int       @default(90)
  preventReuse        Int       @default(5)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([businessId])
}

model UserPasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model SuperAdminIpWhitelist {
  id        String   @id @default(uuid())
  ip        String   @unique
  label     String?
  addedBy   String?
  createdAt DateTime @default(now())
}

model SuperAdminAuditLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String
  targetId   String?
  targetType String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([createdAt])
}
