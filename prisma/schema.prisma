  guestPhone        String?
  guestIdNumber     String?            // passport / national ID
  checkInDate       DateTime
  checkOutDate      DateTime?
  actualCheckIn     DateTime?
  actualCheckOut    DateTime?
  nightCount        Int                @default(1)
  pricePerNightCents Int               @default(0)
  totalAmountCents  Int                @default(0)
  depositCents      Int                @default(0)
  status            String             @default("RESERVED") // RESERVED | CHECKED_IN | CHECKED_OUT | CANCELLED | NO_SHOW
  notes             String?
  orderId           String?            // room service order linked
  saleId            String?            // checkout sale id
  folioCharges      GuestFolioCharge[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([businessId, storeId, status])
  @@index([roomId])
}

model GuestFolioCharge {
  id          String      @id @default(cuid())
  bookingId   String
  booking     RoomBooking @relation(fields: [bookingId], references: [id])
