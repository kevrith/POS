{
  "expo": {
    "name": "KASTRA Agent",
    "slug": "kastra-agent",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kastra-agent",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F0F2F5"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C2D12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ke.kastra.agent",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is used to record where customers are registered and visited.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C2D12"
      },
      "package": "co.ke.kastra.agent",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CALL_PHONE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KASTRA Agent to use your location to register and visit customers."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#030712"
        }
      ],
      "./plugins/with-cleartext-traffic",
      "./plugins/with-gradle-properties"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8597f68c-f697-43e5-b6f8-68744e1f8e28"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8597f68c-f697-43e5-b6f8-68744e1f8e28"
      }
    },
    "owner": "kevrith"
  }
}
