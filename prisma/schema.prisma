  floor                String?
  capacity             Int           @default(2)
  pricePerNightCents   Int           @default(0)
  status               String        @default("AVAILABLE") // AVAILABLE | OCCUPIED | MAINTENANCE | RESERVED
  housekeepingStatus   String        @default("CLEAN") // CLEAN | DIRTY | INSPECTED | OUT_OF_ORDER
  amenities            String?       // JSON string: ["WiFi","AC","TV"]
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  bookings             RoomBooking[]
  housekeepingAssignments HousekeepingAssignment[]

  @@unique([businessId, storeId, number])
  @@index([businessId, storeId, status])
}

