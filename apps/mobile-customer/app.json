{
  "expo": {
    "name": "KASTRA Order",
    "slug": "kastra-customer",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kastra-order",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F9FAFB"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ke.kastra.order",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "package": "co.ke.kastra.order"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#030712"
        }
      ],
      "./plugins/with-cleartext-traffic",
      "./plugins/with-gradle-properties"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "12b1a431-327b-43fa-bb56-981a3d085c0b"
      }
    },
    "owner": "kevrith",
    "updates": {
      "url": "https://u.expo.dev/12b1a431-327b-43fa-bb56-981a3d085c0b"
    }
  }
}
