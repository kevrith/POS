# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/pos_dev?schema=public"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-256-bit-secret"
JWT_EXPIRES_IN="15m"

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3001"

# ─── API server port ─────────────────────────────────────────────────────────
PORT=3000

# ─── M-Pesa / Safaricom Daraja ───────────────────────────────────────────────
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-domain.com/api/payments/mpesa/callback"
MPESA_ENV="sandbox"   # sandbox | production

# ─── KRA eTIMS ───────────────────────────────────────────────────────────────
ETIMS_BASE_URL="https://etims-api.kra.go.ke/etims-api"
ETIMS_ENV="test"      # test | production

# ─── Redis (BullMQ queues) ────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="POS Kenya <receipts@poskenya.co.ke>"

# ─── WhatsApp (Africa's Talking) ─────────────────────────────────────────────
AT_USERNAME=""
AT_API_KEY=""
AT_WHATSAPP_NUMBER=""

# ─── Billing (Paystack) ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=""
