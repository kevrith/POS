  type        String      // ROOM_RATE | FOOD_BEVERAGE | MINIBAR | LAUNDRY | TRANSPORT | OTHER
  description String
  amountCents Int
  quantity    Int         @default(1)
  totalCents  Int
  postedBy    String?
  saleId      String?
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([bookingId])
  @@index([businessId])
}

model BankStatement {
